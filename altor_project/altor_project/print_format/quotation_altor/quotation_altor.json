 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Quotation Print Format - Fixed Footer Overlap</title>\n<style>\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  @page {\n    size: A4;\n    margin-top: 20mm;\n    margin-bottom: 35mm;\n    margin-left: 14mm;\n    margin-right: 14mm;\n  }\n  body {\n    font-family: 'Times New Roman', Times, serif;\n    font-size: 11pt;\n    color: #1a1a1a;\n    background: #fff;\n    margin: 0;\n    padding: 0;\n    overflow-x: hidden;\n    width: 100%;\n    max-width: 100%;\n  }\n  .page-content-wrapper {\n    width: 100%;\n    max-width: 100%;\n    overflow-x: hidden;\n  }\n  .page {\n    width: 100%;\n    max-width: 100%;\n    padding: 0 0 30px 0;\n    overflow-x: hidden;\n  }\n  .letter-head {\n    margin-bottom: 10px;\n    width: 100%;\n    max-width: 100%;\n  }\n  .letter-head img,\n  .letter-head div {\n    max-width: 100%;\n  }\n  .recipient {\n    margin-bottom: 6px;\n    font-size: 10.5pt;\n    font-weight: bold;\n  }\n  .subject-line {\n    text-align: center;\n    font-weight: bold;\n    text-decoration: underline;\n    margin-bottom: 14px;\n    font-size: 11pt;\n    line-height: 1.5;\n  }\n  .salutation {\n    margin-bottom: 8px;\n    font-size: 10.5pt;\n  }\n  .intro-text {\n    margin-bottom: 16px;\n    font-size: 10.5pt;\n    line-height: 1.6;\n  }\n  .price-label {\n    font-weight: bold;\n    text-decoration: underline;\n    margin-bottom: 8px;\n    font-size: 10.5pt;\n  }\n  .price-table {\n    width: 100%;\n    max-width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 16px;\n    font-size: 10.5pt;\n    page-break-inside: avoid;\n    table-layout: fixed;\n  }\n  .price-table th {\n    background-color: #e8e8e8;\n    border: 1px solid #999;\n    padding: 6px 10px;\n    text-align: center;\n    font-weight: bold;\n    font-family: Arial, sans-serif;\n    word-wrap: break-word;\n  }\n  .price-table td {\n    border: 1px solid #999;\n    padding: 7px 10px;\n    vertical-align: top;\n    line-height: 1.5;\n    word-wrap: break-word;\n  }\n  .price-table td.amount {\n    text-align: center;\n    font-weight: bold;\n    white-space: normal;\n    vertical-align: middle;\n    word-break: keep-all;\n  }\n  .price-table tr.grand-total td {\n    font-weight: bold;\n    text-align: center;\n    border-top: 2px solid #333;\n    background-color: #f5f5f5;\n  }\n  .price-table tr.in-words td {\n    text-align: center;\n    font-size: 10pt;\n    border-top: none;\n    padding: 5px 10px 7px;\n    background-color: #f5f5f5;\n  }\n  .price-table ul {\n    margin: 4px 0 0 0;\n    padding-left: 18px;\n  }\n  .price-table ul.no-bullets {\n    list-style: none;\n    padding-left: 0;\n  }\n  .price-table ul li {\n    margin-bottom: 3px;\n    line-height: 1.5;\n    word-wrap: break-word;\n  }\n  .custom-content {\n    font-size: 10.5pt;\n    line-height: 1.6;\n    margin-bottom: 16px;\n    width: 100%;\n    overflow-x: hidden;\n    padding-left: 20px;\n  }\n  .custom-content p {\n    margin-bottom: 6px;\n  }\n  .custom-content ul,\n  .custom-content ol {\n    padding-left: 22px;\n    margin-bottom: 8px;\n  }\n  .custom-content ul li,\n  .custom-content ol li {\n    margin-bottom: 4px;\n    line-height: 1.5;\n  }\n  .custom-content strong,\n  .custom-content b {\n    font-weight: bold;\n  }\n  .ql-editor {\n    padding: 0 !important;\n    margin: 0 !important;\n    min-height: 0 !important;\n    height: auto !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    overflow: hidden !important;\n    box-shadow: none !important;\n    border: none !important;\n    outline: none !important;\n    font-size: 10.5pt !important;\n    font-family: 'Times New Roman', Times, serif !important;\n    line-height: 1.6 !important;\n    color: #1a1a1a !important;\n  }\n  .ql-editor p,\n  .ql-editor li,\n  .ql-editor ol,\n  .ql-editor ul,\n  .ql-editor strong,\n  .ql-editor b,\n  .ql-editor span {\n    font-family: 'Times New Roman', Times, serif !important;\n    font-size: 10.5pt !important;\n    color: #1a1a1a !important;\n    word-break: break-word !important;\n    overflow-wrap: anywhere !important;\n    max-width: 100% !important;\n  }\n  .ql-editor p {\n    margin-bottom: 6px !important;\n  }\n  .ql-editor ol,\n  .ql-editor ul {\n    padding: 0 !important;\n    margin: 0 0 8px 0 !important;\n    list-style: none !important;\n  }\n  .ql-ui {\n    display: none !important;\n  }\n  .ql-editor li[data-list=\"bullet\"] {\n    display: block !important;\n    padding-left: 20px !important;\n    text-indent: -14px !important;\n    margin-bottom: 4px !important;\n    line-height: 1.5 !important;\n    font-family: 'Times New Roman', Times, serif !important;\n    font-size: 10.5pt !important;\n  }\n  .ql-editor li[data-list=\"bullet\"]::before {\n    content: \"\u2022 \" !important;\n    font-family: 'Times New Roman', Times, serif !important;\n    font-size: 10.5pt !important;\n  }\n  .ql-editor li[data-list=\"ordered\"] {\n    display: list-item !important;\n    list-style-type: decimal !important;\n    margin-left: 20px !important;\n    margin-bottom: 4px !important;\n    line-height: 1.5 !important;\n    font-family: 'Times New Roman', Times, serif !important;\n    font-size: 10.5pt !important;\n  }\n  .closing {\n    margin-top: 18px;\n    margin-bottom: 14px;\n    font-size: 10.5pt;\n    line-height: 1.7;\n    page-break-inside: avoid;\n  }\n  .signatory-block {\n    margin-top: 8px;\n    margin-bottom: 20px;\n    font-size: 10.5pt;\n    line-height: 1.8;\n    page-break-inside: avoid;\n  }\n  .signatory-block .company-sig {\n    font-weight: bold;\n  }\n  .boq-heading {\n    font-weight: bold;\n    background-color: #f0f0f0;\n  }\n  #footer-html {\n    margin-top: 10px;\n    padding-top: 8px;\n    border-top: 1px solid #ccc;\n    width: 100%;\n    max-width: 100%;\n    text-align: center;\n    font-size: 9pt;\n    color: #555;\n    position: relative;\n    clear: both;\n    background: white;\n    page-break-inside: avoid;\n    break-inside: avoid;\n    overflow-x: hidden;\n  }\n  .letter-head-footer {\n    margin: 0 auto;\n    max-width: 100%;\n  }\n  .letter-head-footer img {\n    max-width: 100%;\n    height: auto;\n  }\n  @media print {\n    body {\n      margin: 0;\n      padding: 0;\n      display: block;\n      overflow-x: hidden;\n    }\n    .page-content-wrapper {\n      display: block;\n    }\n    #footer-html {\n      position: relative;\n      bottom: 0;\n      left: 0;\n      margin-top: 15px;\n      padding-top: 8px;\n      transform: none;\n      background: white;\n      border-top: 1px solid #aaa;\n    }\n    .letter-head-footer img {\n      max-width: 100%;\n      height: auto;\n    }\n    .letter-head-footer * {\n      position: relative;\n    }\n    .price-table {\n      page-break-inside: avoid;\n    }\n    .signatory-block {\n      margin-bottom: 25px;\n      page-break-inside: avoid;\n    }\n    .closing {\n      page-break-inside: avoid;\n    }\n    .custom-content {\n      page-break-inside: auto;\n    }\n    .price-table td.amount {\n      white-space: normal;\n    }\n  }\n  @media screen {\n    body {\n      background: #e0e0e0;\n      overflow-x: hidden;\n    }\n    .page {\n      max-width: 210mm;\n      margin: 0 auto;\n      background: white;\n      box-shadow: 0 0 5px rgba(0,0,0,0.1);\n      padding: 10mm;\n    }\n    #footer-html {\n      max-width: 210mm;\n      margin: 20px auto 0 auto;\n      background: white;\n    }\n  }\n</style>\n</head>\n<body>\n<div class=\"page-content-wrapper\">\n  <div class=\"letter_head\" style=\"width:100%; margin:0; padding:0;\" id=\"header-html\">\n    {% if letter_head and not no_letterhead -%}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n    {%- endif %}\n  </div>\n  <div class=\"page\">\n    <table style=\"width:100%; border-collapse:collapse; margin-bottom:12px; font-size:10.5pt;\">\n      <tr>\n        <td style=\"text-align:left; width:50%;\">{{ doc.name }}</td>\n        <td style=\"text-align:right; width:50%;\">{{ frappe.format(doc.transaction_date, {\"fieldtype\": \"Date\"}) }}</td>\n      </tr>\n    </table>\n    <div class=\"recipient\">M/s. {{ doc.customer_name }}</div>\n    <div class=\"subject-line\">\n      Sub: &nbsp;{{ doc.custom_subject or (\"Quotation for \" + (doc.items[0].item_name if doc.items else \"\")) }}\n    </div>\n    <div class=\"salutation\">Dear Sir,</div>\n    <div class=\"intro-text\">\n      Thank you for your enquiry inviting us to quote for the subjected works. We are\n      pleased to give our most competitive offer as detailed below.\n    </div>\n    <div class=\"price-label\">A) &nbsp; Price:</div>\n    <table class=\"price-table\">\n      <thead>\n        <tr>\n          <th style=\"width:74%\">Work Description</th>\n          <th style=\"width:26%\">Amount in {{ doc.currency }}</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% if doc.custom_bill_of_quantity %}\n          {%- set boq = frappe.get_doc(\"Bill of Quantity\", doc.custom_bill_of_quantity) -%}\n          {% for template_row in boq.boq_template %}\n          <tr>\n            <td>\n              <strong>{{ template_row.boq_template }}</strong>\n              {%- set matching_items = [] -%}\n              {% for boq_item in boq.table_kfog %}\n                {% if boq_item.boq_template_id == template_row.boq_template %}\n                  {%- set _ = matching_items.append(boq_item) -%}\n                {% endif %}\n              {% endfor %}\n              {% if matching_items %}\n              {%- set ns = namespace(has_bullet_prefix=false) -%}\n              {% for boq_item in matching_items %}\n                {% if boq_item.description %}\n                  {% for line in boq_item.description.split('\\n') %}\n                    {% set stripped = line.strip() %}\n                    {% if stripped and (stripped.startswith('\u2022') or stripped.startswith('\u25cf') or stripped.startswith('\u00b7') or stripped.startswith('-')) %}\n                      {%- set ns.has_bullet_prefix = true -%}\n                    {% endif %}\n                  {% endfor %}\n                {% endif %}\n              {% endfor %}\n              <ul class=\"{{ 'no-bullets' if ns.has_bullet_prefix else '' }}\">\n                {% for boq_item in matching_items %}\n                  {% if boq_item.description %}\n                    {% for line in boq_item.description.split('\\n') %}\n                      {% if line.strip() %}\n                      <li>{{ line.strip() }}</li>\n                      {% endif %}\n                    {% endfor %}\n                  {% endif %}\n                {% endfor %}\n              </ul>\n              {% endif %}\n            </td>\n            <td class=\"amount\">\n              {{ frappe.format(template_row.total_amount, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}\n            </td>\n          </tr>\n          {% endfor %}\n        {% else %}\n          {% for item in doc.items %}\n          <tr>\n            <td>\n              <strong>{{ item.item_name }}</strong>\n              {% if doc.custom_scope_of_work %}\n              {%- set ns = namespace(has_bullet_prefix=false) -%}\n              {% for line in doc.custom_scope_of_work.split('\\n') %}\n                {% set stripped = line.strip() %}\n                {% if stripped and (stripped.startswith('\u2022') or stripped.startswith('\u25cf') or stripped.startswith('\u00b7') or stripped.startswith('-')) %}\n                  {%- set ns.has_bullet_prefix = true -%}\n                {% endif %}\n              {% endfor %}\n              <ul class=\"{{ 'no-bullets' if ns.has_bullet_prefix else '' }}\">\n                {% for line in doc.custom_scope_of_work.split('\\n') %}\n                  {% if line.strip() %}\n                  <li>{{ line.strip() }}</li>\n                  {% endif %}\n                {% endfor %}\n              </ul>\n              {% elif item.description %}\n              {%- set ns = namespace(has_bullet_prefix=false) -%}\n              {% for line in item.description.split('\\n') %}\n                {% set stripped = line.strip() %}\n                {% if stripped and (stripped.startswith('\u2022') or stripped.startswith('\u25cf') or stripped.startswith('\u00b7') or stripped.startswith('-')) %}\n                  {%- set ns.has_bullet_prefix = true -%}\n                {% endif %}\n              {% endfor %}\n              <ul class=\"{{ 'no-bullets' if ns.has_bullet_prefix else '' }}\">\n                {% for line in item.description.split('\\n') %}\n                  {% if line.strip() %}\n                  <li>{{ line.strip() }}</li>\n                  {% endif %}\n                {% endfor %}\n              </ul>\n              {% endif %}\n            </td>\n            <td class=\"amount\">\n              {{ frappe.format(item.amount, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}\n            </td>\n          </tr>\n          {% endfor %}\n        {% endif %}\n        <tr class=\"grand-total\">\n          <td>Grand Total &nbsp; ({{ doc.currency }})</td>\n          <td class=\"amount\">\n            {{ frappe.format(doc.grand_total, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}\n          </td>\n        </tr>\n        {% if doc.in_words %}\n        <tr class=\"in-words\">\n          <td colspan=\"2\">({{ doc.in_words }})</td>\n        </tr>\n        {% endif %}\n      </tbody>\n    </table>\n    {% if doc.custom_quotation_content %}\n    <div class=\"custom-content\">\n      {{ doc.custom_quotation_content }}\n    </div>\n    {% endif %}\n    <div class=\"closing\">\n      We trust you will find our offer in line with your requirements and we now look\n      forward to receiving your valued order.\n    </div>\n    <div class=\"signatory-block\">\n      <div>Yours truly,</div>\n      <div class=\"company-sig\">For {{ doc.company }}</div>\n    </div>\n  </div>\n</div>\n<div id=\"footer-html\" class=\"visible-pdf\">\n  {% if not is_no_need_letterhead and footer %}\n  <div class=\"letter-head-footer\">{{ footer }}</div>\n  {% endif %}\n</div>\n</body>\n</html>",
