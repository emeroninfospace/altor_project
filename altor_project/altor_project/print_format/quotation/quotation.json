 "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  body {\n    font-family: 'Times New Roman', Times, serif;\n    font-size: 11pt;\n    color: #1a1a1a;\n    background: #fff;\n  }\n\n  .page {\n    width: 100%;\n    padding: 10mm 14mm 30mm 14mm;\n    position: relative;\n  }\n\n  /* \u2500\u2500 Header \u2500\u2500 */\n  .header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border-bottom: 3px solid #1a3a6b;\n    padding-bottom: 10px;\n    margin-bottom: 16px;\n  }\n\n  .company-name-block {\n    line-height: 1.3;\n  }\n\n  .company-arabic {\n    font-size: 13pt;\n    font-weight: bold;\n    color: #1a3a6b;\n    direction: rtl;\n    font-family: Arial, sans-serif;\n  }\n\n  .company-english {\n    font-size: 11.5pt;\n    font-weight: bold;\n    color: #1a3a6b;\n    letter-spacing: 0.4px;\n    font-family: Arial, sans-serif;\n  }\n\n  /* \u2500\u2500 Meta Row \u2500\u2500 */\n  .meta-row {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 12px;\n    font-size: 10.5pt;\n  }\n\n  /* \u2500\u2500 Recipient \u2500\u2500 */\n  .recipient {\n    margin-bottom: 6px;\n    font-size: 10.5pt;\n    font-weight: bold;\n  }\n\n  /* \u2500\u2500 Subject \u2500\u2500 */\n  .subject-line {\n    text-align: center;\n    font-weight: bold;\n    text-decoration: underline;\n    margin-bottom: 14px;\n    font-size: 11pt;\n  }\n\n  /* \u2500\u2500 Body text \u2500\u2500 */\n  .salutation {\n    margin-bottom: 8px;\n    font-size: 10.5pt;\n  }\n\n  .intro-text {\n    margin-bottom: 16px;\n    font-size: 10.5pt;\n    line-height: 1.6;\n  }\n\n  /* \u2500\u2500 Project Info Table \u2500\u2500 */\n  .project-info-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 14px;\n    font-size: 10.5pt;\n  }\n\n  .project-info-table td {\n    padding: 4px 8px;\n    vertical-align: top;\n  }\n\n  .project-info-table td.label {\n    font-weight: bold;\n    width: 22%;\n    white-space: nowrap;\n  }\n\n  .project-info-table td.colon {\n    width: 2%;\n  }\n\n  .project-info-table td.value {\n    width: 76%;\n  }\n\n  /* \u2500\u2500 Price table label \u2500\u2500 */\n  .price-label {\n    font-weight: bold;\n    text-decoration: underline;\n    margin-bottom: 8px;\n    font-size: 10.5pt;\n  }\n\n  /* \u2500\u2500 Price Table \u2500\u2500 */\n  .price-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 16px;\n    font-size: 10.5pt;\n  }\n\n  .price-table th {\n    background-color: #e8e8e8;\n    border: 1px solid #999;\n    padding: 6px 10px;\n    text-align: center;\n    font-weight: bold;\n    font-family: Arial, sans-serif;\n  }\n\n  .price-table td {\n    border: 1px solid #999;\n    padding: 7px 10px;\n    vertical-align: top;\n    line-height: 1.5;\n  }\n\n  .price-table td.amount {\n    text-align: center;\n    font-weight: bold;\n    white-space: nowrap;\n    vertical-align: middle;\n  }\n\n  .price-table ul {\n    margin: 4px 0 0 0;\n    padding-left: 18px;\n  }\n\n  .price-table ul li {\n    margin-bottom: 3px;\n  }\n\n  .price-table tr.grand-total td {\n    font-weight: bold;\n    text-align: center;\n    border-top: 2px solid #333;\n    background-color: #f5f5f5;\n  }\n\n  .price-table tr.in-words td {\n    text-align: center;\n    font-size: 10pt;\n    border-top: none;\n    padding: 5px 10px 7px;\n    background-color: #f5f5f5;\n  }\n\n  /* \u2500\u2500 Custom Content (Text Editor) \u2500\u2500 */\n  .custom-content {\n    font-size: 10.5pt;\n    line-height: 1.6;\n    margin-bottom: 16px;\n  }\n\n  .custom-content p {\n    margin-bottom: 6px;\n  }\n\n  .custom-content ul,\n  .custom-content ol {\n    padding-left: 22px;\n    margin-bottom: 8px;\n  }\n\n  .custom-content ul li,\n  .custom-content ol li {\n    margin-bottom: 4px;\n    line-height: 1.5;\n  }\n\n  .custom-content strong,\n  .custom-content b {\n    font-weight: bold;\n  }\n\n  /* \u2500\u2500 LPO Block \u2500\u2500 */\n  .lpo-block {\n    margin-bottom: 14px;\n    font-size: 10.5pt;\n    line-height: 1.7;\n  }\n\n  /* \u2500\u2500 Closing \u2500\u2500 */\n  .closing {\n    margin-top: 18px;\n    margin-bottom: 14px;\n    font-size: 10.5pt;\n    line-height: 1.7;\n  }\n\n  .signatory-block {\n    margin-top: 8px;\n    font-size: 10.5pt;\n    line-height: 1.8;\n  }\n\n  .signatory-block .company-sig {\n    font-weight: bold;\n    margin-bottom: 28px;\n  }\n\n  /* \u2500\u2500 Footer \u2500\u2500 */\n  .footer {\n    position: fixed;\n    bottom: 8mm;\n    left: 14mm;\n    right: 14mm;\n    border-top: 2px solid #1a3a6b;\n    padding-top: 5px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 8pt;\n    color: #444;\n    font-family: Arial, sans-serif;\n  }\n\n  .footer-contact {\n    line-height: 1.6;\n  }\n\n  @media print {\n    .page { padding-bottom: 30mm; }\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <!-- \u2550\u2550 HEADER \u2550\u2550 -->\n  <div class=\"header\">\n    <div class=\"company-name-block\">\n      <div class=\"company-arabic\">\u0628\u0646\u0634\u0645\u0627\u0631\u0643 \u0644\u0645\u0642\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0628\u0646\u0627\u0621 \u0630.\u0645.\u0645</div>\n      <div class=\"company-english\">ALTOR BUILDING CONTRACTING L.L.C</div>\n    </div>\n  </div>\n\n  <!-- \u2550\u2550 REF & DATE \u2550\u2550 -->\n  <div class=\"meta-row\">\n    <span>{{ doc.name }}</span>\n    <span>{{ frappe.format(doc.transaction_date, {\"fieldtype\": \"Date\"}) }}</span>\n  </div>\n\n  <!-- \u2550\u2550 RECIPIENT \u2550\u2550 -->\n  <div class=\"recipient\">M/s. {{ doc.customer_name }}</div>\n\n  <!-- \u2550\u2550 SUBJECT \u2550\u2550 -->\n  <div class=\"subject-line\">\n    Sub: &nbsp;{{ doc.custom_scope_of_work or doc.custom_project or \"Quotation\" }}\n  </div>\n\n  <!-- \u2550\u2550 SALUTATION \u2550\u2550 -->\n  <div class=\"salutation\">Dear Sir,</div>\n\n  <!-- \u2550\u2550 INTRO \u2550\u2550 -->\n  <div class=\"intro-text\">\n    Thank you for your enquiry inviting us to quote for the subjected works. We are\n    pleased to give our most competitive offer as detailed below.\n  </div>\n\n  <!-- \u2550\u2550 PROJECT INFO \u2550\u2550 -->\n  {% if doc.custom_project or doc.custom_location or doc.lpo_ref %}\n  <table class=\"project-info-table\">\n    {% if doc.custom_project %}\n    <tr>\n      <td class=\"label\">Project</td>\n      <td class=\"colon\">:</td>\n      <td class=\"value\">{{ doc.custom_project }}</td>\n    </tr>\n    {% endif %}\n    {% if doc.custom_location %}\n    <tr>\n      <td class=\"label\">Location</td>\n      <td class=\"colon\">:</td>\n      <td class=\"value\">{{ doc.custom_location }}</td>\n    </tr>\n    {% endif %}\n    {% if doc.lpo_ref %}\n    <tr>\n      <td class=\"label\">LPO Ref</td>\n      <td class=\"colon\">:</td>\n      <td class=\"value\">\n        {{ doc.lpo_ref }}\n        {% if doc.lpo_date %}\n          &nbsp;&nbsp; <strong>Date:</strong> {{ frappe.format(doc.lpo_date, {\"fieldtype\": \"Date\"}) }}\n        {% endif %}\n      </td>\n    </tr>\n    {% endif %}\n  </table>\n  {% endif %}\n\n  <!-- \u2550\u2550 PRICE TABLE \u2550\u2550 -->\n  <div class=\"price-label\">A) &nbsp; Price:</div>\n\n  <table class=\"price-table\">\n    <thead>\n      <tr>\n        <th style=\"width: 74%\">Work Description</th>\n        <th style=\"width: 26%\">Amount in {{ doc.currency }}</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td>\n          {% if item.item_name %}\n            <strong>{{ item.item_name }}</strong>\n          {% endif %}\n          {% if item.description %}\n            <ul>\n              {% for line in item.description.split('\\n') %}\n                {% if line.strip() %}\n                  <li>{{ line.strip() }}</li>\n                {% endif %}\n              {% endfor %}\n            </ul>\n          {% endif %}\n        </td>\n        <td class=\"amount\">\n          {{ frappe.format(item.amount, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}\n        </td>\n      </tr>\n      {% endfor %}\n\n      <!-- Grand Total -->\n      <tr class=\"grand-total\">\n        <td>Grand Total &nbsp; ({{ doc.currency }})</td>\n        <td class=\"amount\">\n          {{ frappe.format(doc.grand_total, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}\n        </td>\n      </tr>\n\n      <!-- Amount in Words -->\n      {% if doc.in_words %}\n      <tr class=\"in-words\">\n        <td colspan=\"2\">({{ doc.in_words }})</td>\n      </tr>\n      {% endif %}\n    </tbody>\n  </table>\n\n  <!-- \u2550\u2550 CUSTOM CONTENT (Text Editor) \u2550\u2550 -->\n  {% if doc.custom_quotation_content %}\n  <div class=\"custom-content\">\n    {{ doc.custom_quotation_content }}\n  </div>\n  {% endif %}\n\n  <!-- \u2550\u2550 CLOSING \u2550\u2550 -->\n  <div class=\"closing\">\n    We trust you will find our offer in line with your requirements and we now look\n    forward to receiving your valued order.\n  </div>\n\n  <!-- \u2550\u2550 SIGNATORY \u2550\u2550 -->\n  <div class=\"signatory-block\">\n    <div>Yours truly,</div>\n    <div class=\"company-sig\">For {{ doc.company }}</div>\n  </div>\n\n</div>\n\n<!-- \u2550\u2550 FOOTER \u2550\u2550 -->\n<div class=\"footer\">\n  <div class=\"footer-contact\">\n    +971 6 5636589, 050 1929869 &nbsp;|&nbsp;\n    Office No. 147, Mohammed Abdulla Saeed, Ajman Industrial 1, Ajman - U.A.E. &nbsp;|&nbsp;\n    project@catalystgroup.ae &nbsp;|&nbsp; www.catalystgroup.ae\n  </div>\n</div>\n\n</body>\n</html>",
